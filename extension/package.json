{
  "name": "@svm/extension",
  "version": "0.1.0",
  "description": "Secure Vault Manager Browser Extension (Manifest V3) for Chrome, Brave, Edge & Firefox",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/post-build.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src scripts vite.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,mjs,css,html}\" \"scripts/**/*.{js,mjs,ts}\" \"public/*.json\" popup.html package.json tsconfig.json vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,mjs,css,html}\" \"scripts/**/*.{js,mjs,ts}\" \"public/*.json\" popup.html package.json tsconfig.json vite.config.ts"
  },
  "license": "Proprietary",
  "devDependencies": {
    "oxlint": "^1.93.0",
    "prettier": "^3.9.6"
  }
}
