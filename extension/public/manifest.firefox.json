{
  "manifest_version": 3,
  "name": "Secure Vault Manager",
  "version": "0.1.0",
  "description": "Autofill logins, verification codes, and passkeys securely from Secure Vault Manager.",
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@secure-vault.hephaestus.io",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "clipboardWrite",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Secure Vault Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["passkey_injected.js", "svm_wasm.wasm"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open Secure Vault Manager"
    }
  }
}
