/* ==============================================================================
 * Secure Vault Manager - Light Theme (Catppuccin Latte)
 * ============================================================================== */

/* Cửa sổ gốc & font hệ thống */
QMainWindow, QDialog {
    background-color: #eff1f5;
    color: #4c4f69;
}

/* Toàn bộ nhãn văn bản mặc định trong suốt */
QLabel {
    background: transparent;
    color: #4c4f69;
}

/* Khung cửa sổ chính */
#CentralWidget {
    background-color: #eff1f5;
    border: 1px solid #ccd0da;
}

/* ==============================================================================
 * Thanh Tiêu Đề Tích Hợp (UnifiedHeaderBar)
 * ============================================================================== */
#UnifiedHeaderBar {
    background-color: #e6e9ef;
    border-bottom: 1px solid #ccd0da;
}

#HeaderLogo {
    background: transparent;
}

/* Tiêu đề tài liệu / cửa sổ căn giữa */
#HeaderTitleLabel {
    color: #4c4f69;
    font-size: 13px;
    font-weight: 500;
    background: transparent;
}

/* Thanh Menu nhúng trực tiếp trên HeaderBar */
#EmbeddedMenuBar {
    background: transparent;
    color: #4c4f69;
}

#EmbeddedMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    border-radius: 4px;
    color: #4c4f69;
}

#EmbeddedMenuBar::item:selected,
#EmbeddedMenuBar::item:pressed {
    background-color: #ccd0da;
    color: #1e1e2e;
}

/* Menu xổ xuống (QMenu) cho Light Theme */
QMenu {
    background-color: #eff1f5;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 4px 2px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 24px 6px 30px;
    border-radius: 4px;
    margin: 1px 2px;
}

QMenu::item:selected {
    background-color: #dce0e8;
    color: #1e1e2e;
}

QMenu::item:disabled {
    color: #9ca0b0;
}

QMenu::separator {
    height: 1px;
    background-color: #ccd0da;
    margin: 4px 6px;
}

/* Dấu tích checkbox/radio tùy biến cho QMenu */
QMenu::indicator {
    width: 14px;
    height: 14px;
    left: 8px;
}

QMenu::indicator:checked {
    image: url(:/icons/menu_check_light.svg);
}

QMenu::indicator:unchecked {
    image: none;
}

/* ==============================================================================
 * Các Nút Điều Khiển Cửa Sổ (Window Controls)
 * ============================================================================== */
#WinMinBtn, #WinMaxBtn {
    background: transparent;
    border: none;
    border-radius: 0px;
}

#WinMinBtn:hover, #WinMaxBtn:hover {
    background-color: #ccd0da;
}

#WinMinBtn:pressed, #WinMaxBtn:pressed {
    background-color: #bcc0cc;
}

/* Nút Close: Màu đỏ chuẩn với icon dấu X trắng nổi bật khi hover/pressed */
#WinCloseBtn {
    background: transparent;
    border: none;
    border-radius: 0px;
}

#WinCloseBtn:hover {
    background-color: #e81123;
    qproperty-icon: url(:/icons/win_close_white.svg);
}

#WinCloseBtn:pressed {
    background-color: #c40e1d;
    qproperty-icon: url(:/icons/win_close_white.svg);
}

/* ==============================================================================
 * Vùng Chứa Nội Dung (ContentArea) & Khung Thẻ (Cards)
 * ============================================================================== */
#ContentArea {
    background-color: #eff1f5;
}

#CardWidget {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 8px;
    padding: 24px;
}

#CardWidget QLabel {
    background: transparent;
}

#CardTitleLabel {
    color: #1e1e2e;
    font-size: 18px;
    font-weight: bold;
    background: transparent;
}

#CardDescLabel {
    color: #6c6f85;
    font-size: 13px;
    background: transparent;
}

/* ==============================================================================
 * Các Nút Bấm Thao Tác (Buttons)
 * ============================================================================== */
QPushButton {
    background-color: #e6e9ef;
    color: #4c4f69;
    border: 1px solid #bcc0cc;
    border-radius: 5px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #dce0e8;
    color: #1e1e2e;
}

QPushButton:pressed {
    background-color: #ccd0da;
}

QPushButton#PrimaryButton {
    background-color: #1e1e2e;
    color: #ffffff;
    border: 1px solid #1e1e2e;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background-color: #2f3540;
    border-color: #2f3540;
}

QPushButton#PrimaryButton:pressed {
    background-color: #11111b;
    border-color: #11111b;
}

QPushButton#DangerButton {
    background-color: #f6f8fa;
    color: #cf222e;
    border: 1px solid #ccd0da;
}

QPushButton#DangerButton:hover {
    background-color: #ffebe9;
    border-color: #cf222e;
}

QPushButton#DangerButton:pressed {
    background-color: #ffcecb;
}

/* ==============================================================================
 * Ô Nhập Liệu (Input Fields)
 * ============================================================================== */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 5px;
    padding: 6px 10px;
    font-size: 13px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #2f3540;
    background-color: #ffffff;
}

/* ==============================================================================
 * Thanh Cuộn Tối Giản (QScrollBar)
 * ============================================================================== */
QScrollBar:vertical {
    background-color: #eff1f5;
    width: 8px;
    margin: 0;
    border-radius: 4px;
}

QScrollBar:handle:vertical {
    background-color: #ccd0da;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar:handle:vertical:hover {
    background-color: #bcc0cc;
}

QScrollBar:add-line:vertical, QScrollBar:sub-line:vertical,
QScrollBar:add-page:vertical, QScrollBar:sub-page:vertical {
    background: none;
    border: none;
}

QScrollBar:horizontal {
    background-color: #eff1f5;
    height: 8px;
    margin: 0;
    border-radius: 4px;
}

QScrollBar:handle:horizontal {
    background-color: #ccd0da;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar:handle:horizontal:hover {
    background-color: #bcc0cc;
}

QScrollBar:add-line:horizontal, QScrollBar:sub-line:horizontal,
QScrollBar:add-page:horizontal, QScrollBar:sub-page:horizontal {
    background: none;
    border: none;
}

/* ==============================================================================
 * Thanh Trạng Thái (StatusBar)
 * ============================================================================== */
#StatusBar, QStatusBar {
    background-color: #e6e9ef;
    border-top: 1px solid #ccd0da;
    color: #6c6f85;
    font-size: 11px;
    min-height: 24px;
}

QStatusBar::item {
    border: none;
}

#StatusBar QLabel {
    color: #8c959f;
    font-size: 11px;
    padding: 2px 4px;
    background: transparent;
}

/* ==============================================================================
 * Cấu Trúc 3 Cột (MainThreeColumnSplitter)
 * ============================================================================== */
#MainThreeColumnSplitter {
    background-color: #eff1f5;
}

#MainThreeColumnSplitter::handle {
    background-color: #ccd0da;
    width: 1px;
}

#MainThreeColumnSplitter::handle:hover {
    background-color: #4c4f69;
}

/* Header Action Buttons */
#HeaderSidebarToggleBtn, #HeaderCommandPaletteBtn, #HeaderThemeToggleBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px;
}

#HeaderSidebarToggleBtn:hover, #HeaderCommandPaletteBtn:hover, #HeaderThemeToggleBtn:hover {
    background-color: #ccd0da;
}

/* 1. Cột 1: SidebarView */
#SidebarView,
#SidebarExpandedContainer,
#SidebarCollapsedContainer {
    background-color: #e6e9ef;
    background: #e6e9ef;
    border-right: 1px solid #ccd0da;
}

#SidebarToggleBtn {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 0;
}

#SidebarToggleBtn:hover {
    background-color: #ccd0da;
    border-color: #4c4f69;
}

#SidebarCompactVaultBtn {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 4px;
}

#SidebarCompactVaultBtn:hover {
    background-color: #dce0e8;
    border-color: #4c4f69;
}

#SidebarCompactList {
    background: transparent;
    border: none;
    outline: none;
}

#SidebarCompactList::item {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

#SidebarCompactLockBtn {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 6px;
    color: #d20f39;
}

#SidebarCompactLockBtn:hover {
    background-color: #dce0e8;
    border-color: #d20f39;
}

#SidebarHeaderWidget {
    background: transparent;
    border-bottom: 1px solid #ccd0da;
}

#VaultProfileBtn {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 0;
    min-height: 32px;
}

#VaultProfileBtn:hover {
    background-color: #dce0e8;
    border-color: #4c4f69;
}

#VaultProfileBtn::menu-indicator {
    image: none;
    width: 0;
}

#VaultTitleLabel {
    color: #4c4f69;
    font-weight: 600;
    font-size: 13px;
    background: transparent;
}

#VaultChevronLabel {
    background: transparent;
    margin-right: 4px;
}

#LockBtnText {
    color: #d20f39;
    font-weight: 600;
    font-size: 13px;
    background: transparent;
}

#VaultSwitchMenu {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 8px;
    padding: 4px;
    color: #4c4f69;
}

#SidebarNavList {
    background: transparent;
    border: none;
    outline: none;
    padding: 4px 0;
}

#SidebarFooterWidget {
    background: transparent;
    border-top: 1px solid #ccd0da;
}

#SidebarLockBtn {
    background-color: transparent;
    border: 1px solid rgba(210, 15, 57, 0.25);
    border-radius: 6px;
    padding: 0;
    min-height: 32px;
    color: #d20f39;
    font-weight: 600;
    text-align: left;
}

#SidebarLockBtn:hover {
    background-color: rgba(210, 15, 57, 0.12);
    border-color: #d20f39;
}

/* 2. Cột 2: ItemListView */
#ItemListView {
    background-color: #eff1f5;
    background: #eff1f5;
    border-right: 1px solid #ccd0da;
}

#ItemListSearchEdit {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 0 10px;
    color: #4c4f69;
    font-size: 13px;
    min-height: 28px;
    max-height: 28px;
}

#ItemListSearchEdit:focus {
    border-color: #2f3540;
    background-color: #ffffff;
}

#ItemListCountLabel {
    color: #6c6f85;
    font-size: 11px;
    font-weight: 600;
}

#ItemListSortCombo {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 2px 22px 2px 8px;
    color: #4c4f69;
    font-size: 12px;
    font-weight: 500;
}

#ItemListSortCombo:hover {
    border-color: #4c4f69;
    color: #1e1e2e;
}

#ItemListSortCombo:focus {
    border-color: #2f3540;
}

QComboBox {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 2px 22px 2px 8px;
    color: #4c4f69;
    font-size: 12px;
    font-weight: 500;
}

QComboBox:hover {
    border-color: #4c4f69;
}

QComboBox:focus {
    border-color: #2f3540;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    border-left: none;
}

QComboBox::down-arrow {
    image: url(:/icons/chevron_down_light.svg);
    width: 10px;
    height: 10px;
}

QComboBoxPrivateContainer {
    background-color: transparent;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #4c4f69;
    selection-background-color: #eaeff5;
    selection-color: #1e1e2e;
    border: 1px solid #ccd0da;
    border-radius: 8px;
    padding: 6px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 10px;
    border-radius: 6px;
    color: #4c4f69;
    font-size: 12px;
    font-weight: 500;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background-color: #eaeff5;
    color: #1e1e2e;
}

#ItemListNewBtn {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 0;
    min-height: 28px;
    max-height: 28px;
    min-width: 28px;
    max-width: 28px;
}

#ItemListNewBtn:hover {
    background-color: #dce0e8;
    border-color: #4c4f69;
}

#ItemListNewBtn:pressed {
    background-color: #bcc0cc;
    border-color: #2f3540;
}

#ItemCardListView {
    background: transparent;
    border: none;
    outline: none;
}

/* 3. Cột 3: DetailInspectorView */
#DetailInspectorView,
#DetailScrollArea,
#DetailScrollViewport,
#DetailContentContainer {
    background-color: #eff1f5;
    background: #eff1f5;
    border: none;
}

#EmptyStateTitle {
    color: #4c4f69;
    font-size: 18px;
    font-weight: bold;
}

#EmptyStateDesc {
    color: #7c7f93;
    font-size: 13px;
    line-height: 1.6;
}

#DetailHeaderCard {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 8px;
}

#DetailHeaderIcon {
    background-color: #e6e9ef;
    border-radius: 8px;
}

#DetailHeaderTitle {
    color: #4c4f69;
}

#DetailHeaderTitleInput {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 4px 10px;
    color: #1e1e2e;
    font-size: 15px;
    font-weight: 600;
    selection-background-color: #2f3540;
    selection-color: #ffffff;
}

#DetailHeaderTitleInput:focus {
    border-color: #2f3540;
    background-color: #ffffff;
}

#DetailCategoryBadge {
    background-color: #e6e9ef;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

#DetailCategoryCombo {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 2px 22px 2px 8px;
    color: #4c4f69;
    font-size: 12px;
    font-weight: 500;
}

#DetailCategoryCombo:hover {
    border-color: #4c4f69;
    background-color: #f6f8fa;
}

#DetailCategoryCombo:focus {
    border-color: #2f3540;
}

#DetailCategoryCombo::drop-down {
    border: none;
    width: 18px;
}

#DetailCategoryCombo::down-arrow {
    image: url(:/icons/chevron_down_light.svg);
    width: 10px;
    height: 10px;
}

#DetailUpdatedLabel {
    color: #7c7f93;
    font-size: 11px;
}

#DetailHeaderFavBtn {
    background-color: #e6e9ef;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 0;
    color: #4c4f69;
}

#DetailHeaderFavBtn:hover {
    background-color: #dce0e8;
    border-color: #4c4f69;
}

#DetailHeaderEditBtn {
    background-color: #e6e9ef;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 0 14px;
    color: #4c4f69;
    font-size: 13px;
    font-weight: 500;
}

#DetailHeaderEditBtn:hover {
    background-color: #dce0e8;
    border-color: #4c4f69;
    color: #1e1e2e;
}

#DetailHeaderCancelBtn {
    background-color: #ffffff;
    color: #4c4f69;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 0 16px;
    font-size: 13px;
    font-weight: 500;
}

#DetailHeaderCancelBtn:hover {
    background-color: #f2f3f7;
    border-color: #4c4f69;
    color: #1e1e2e;
}

#DetailHeaderSaveBtn {
    background-color: #1e1e2e;
    color: #ffffff;
    border: 1px solid #1e1e2e;
    border-radius: 6px;
    padding: 0 18px;
    font-size: 13px;
    font-weight: 600;
}

#DetailHeaderSaveBtn:hover {
    background-color: #2f3540;
    border-color: #2f3540;
}

#DetailHeaderSaveBtn:pressed {
    background-color: #11111b;
    border-color: #11111b;
}

#TotpFieldWidget {
    background: transparent;
    border: none;
}

#TotpSectionHeader {
    color: #6c6f85;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

#TotpTimerLabel {
    color: #40a02b;
    font-weight: bold;
    font-size: 12px;
}

#TotpCodeDisplay {
    color: #4c4f69;
    letter-spacing: 2px;
}

#TotpCopyBtn {
    background: transparent;
    border: 1px solid #dce0e8;
    border-radius: 6px;
    padding: 4px;
}

#TotpCopyBtn:hover {
    background-color: #dce0e8;
    border-color: #4c4f69;
}

#TotpProgressBar {
    background-color: #ccd0da;
    border-radius: 2px;
}

#TotpProgressBar::chunk {
    background-color: #40a02b;
    border-radius: 2px;
}

#DetailSectionCard {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 10px;
}

#DetailSectionHeader {
    color: #5c5f77;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 0.8px;
    padding-bottom: 2px;
}

#FieldRowDivider {
    background-color: #e6e9ef;
    min-height: 1px;
    max-height: 1px;
    border: none;
    margin: 2px 6px;
}

#FieldRowWidget, #CustomFieldRowWidget, #TotpFieldWidget {
    background: transparent;
    border: none;
}

#FieldRowLabel {
    color: #6c6f85;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

#FieldRowValue {
    color: #4c4f69;
    font-size: 13px;
    font-weight: 500;
}

#FieldRowInput {
    background-color: #f2f3f7;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 6px 10px;
    color: #4c4f69;
    font-size: 13px;
}

#FieldRowInput:focus {
    border-color: #2f3540;
    background-color: #ffffff;
}

#FieldRowActionBtn {
    background: transparent;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 4px;
}

#FieldRowActionBtn:hover {
    background-color: #dce0e8;
    border-color: #4c4f69;
}

#CustomFieldKindCombo {
    background-color: #f2f3f7;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 2px 8px;
    color: #4c4f69;
    font-size: 12px;
}

#CustomFieldKindCombo:focus {
    border-color: #2f3540;
}

#CustomFieldBoolEdit {
    color: #2f3540;
    font-size: 13px;
    font-weight: 500;
    spacing: 8px;
    padding: 2px 4px;
}

#CustomFieldBoolEdit::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #ccd0da;
    background-color: #ffffff;
}

#CustomFieldBoolEdit::indicator:hover {
    border-color: #2f3540;
}

#CustomFieldBoolEdit::indicator:checked {
    background-color: #1e1e2e;
    border-color: #1e1e2e;
    image: url(:/icons/checkbox_check_light.svg);
}

#CustomFieldDateEdit {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 4px 10px;
    color: #2f3540;
    font-size: 13px;
}

#CustomFieldDateEdit:focus {
    border-color: #2f3540;
}

#CustomFieldDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: none;
}

#CustomFieldDateEdit::down-arrow {
    image: url(:/icons/chevron_down_light.svg);
    width: 12px;
    height: 12px;
}

/* QCalendarWidget Theme (Light Neutral Slate) */
QCalendarWidget {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 8px;
    min-width: 260px;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #ffffff;
    border-bottom: 1px solid #e6e9ef;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 34px;
    padding: 2px 4px;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #2f3540;
    font-size: 12px;
    font-weight: 600;
    margin: 2px;
    padding: 2px 6px;
}

QCalendarWidget QToolButton:hover {
    background-color: #eef1f5;
    border-color: #ccd0da;
    color: #1e1e2e;
}

QCalendarWidget QToolButton:pressed {
    background-color: #dce0e8;
}

QCalendarWidget #qt_calendar_prevmonth {
    qproperty-icon: url(:/icons/chevron_left_light.svg);
    icon-size: 12px 12px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
}

QCalendarWidget #qt_calendar_nextmonth {
    qproperty-icon: url(:/icons/chevron_right_light.svg);
    icon-size: 12px 12px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
}

QCalendarWidget #qt_calendar_monthbutton,
QCalendarWidget #qt_calendar_yearbutton {
    color: #2f3540;
    font-weight: 600;
    font-size: 12px;
    padding: 2px 8px;
}

QCalendarWidget QSpinBox {
    background-color: #ffffff;
    color: #2f3540;
    border: 1px solid #ccd0da;
    border-radius: 4px;
    padding: 2px 4px;
    font-size: 12px;
    selection-background-color: #1e1e2e;
    selection-color: #ffffff;
}

QCalendarWidget QMenu {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 4px;
    color: #2f3540;
}

QCalendarWidget QMenu::item {
    padding: 4px 12px;
    border-radius: 4px;
}

QCalendarWidget QMenu::item:selected {
    background-color: #eaeff5;
    color: #1e1e2e;
}

QCalendarWidget QTableView {
    background-color: #ffffff;
    selection-background-color: #1e1e2e;
    selection-color: #ffffff;
    border: none;
    outline: none;
    alternate-background-color: #ffffff;
}

QCalendarWidget QTableView:enabled {
    color: #2f3540;
}

QCalendarWidget QTableView:disabled {
    color: #9ca3af;
}

QCalendarWidget QTableView::item {
    border-radius: 4px;
    padding: 2px;
}

QCalendarWidget QTableView::item:hover {
    background-color: #eef1f5;
    color: #1e1e2e;
}

QCalendarWidget QTableView::item:selected {
    background-color: #1e1e2e;
    color: #ffffff;
    font-weight: bold;
}

QCalendarWidget QHeaderView {
    background-color: #ffffff;
    border: none;
}

QCalendarWidget QHeaderView::section {
    background-color: #ffffff;
    color: #5c5f77;
    border: none;
    padding: 4px;
    font-size: 11px;
    font-weight: 600;
}

#CustomFieldDeleteBtn {
    background: transparent;
    border: 1px solid #ccd0da;
    border-radius: 6px;
    padding: 4px;
}

#CustomFieldDeleteBtn:hover {
    background-color: #ffdce0;
    border-color: #d20f39;
}

#CustomFieldAddBtn, #AddTotpBtn {
    background-color: #ffffff;
    border: 1px dashed #bcc0cc;
    border-radius: 6px;
    color: #4c4f69;
    font-weight: 600;
    font-size: 12px;
}

#CustomFieldAddBtn:hover, #AddTotpBtn:hover {
    background-color: #e6e9ef;
    border-color: #4c4f69;
    color: #1e1e2e;
}

/* 4. Command Palette Dialog */
#CommandPaletteCard {
    background-color: #ffffff;
    border: 1px solid #ccd0da;
    border-radius: 12px;
}

#PaletteSearchInput {
    background-color: #e6e9ef;
    border: 1px solid #ccd0da;
    border-radius: 8px;
    padding: 10px 14px;
    color: #4c4f69;
    font-size: 15px;
}

#PaletteSearchInput:focus {
    border-color: #2f3540;
}

#PaletteResultList {
    background: transparent;
    border: none;
    outline: none;
}
