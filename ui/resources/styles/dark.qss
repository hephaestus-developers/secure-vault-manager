/* ==============================================================================
 * Secure Vault Manager - Dark Theme (Catppuccin Mocha)
 * ============================================================================== */

/* Cửa sổ gốc & font hệ thống */
QMainWindow, QDialog {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border-radius: 0px;
}

QDialog {
    border: 1px solid #45475a;
    border-radius: 0px;
}

/* Toàn bộ nhãn văn bản mặc định trong suốt */
QLabel {
    background: transparent;
    color: #cdd6f4;
}

/* Khung cửa sổ chính */
#CentralWidget {
    background-color: #1e1e2e;
    border: 1px solid #45475a;
}

#CentralWidget[maximized="true"] {
    border: none;
}

/* ==============================================================================
 * Thanh Tiêu Đề Tích Hợp (UnifiedHeaderBar)
 * ============================================================================== */
#UnifiedHeaderBar {
    background-color: #181825;
    border: none;
    border-bottom: 1px solid #45475a;
    border-radius: 0px;
}

#HeaderLogo {
    background: transparent;
}

/* Tiêu đề tài liệu / cửa sổ căn giữa */
#HeaderTitleLabel {
    color: #cdd6f4;
    font-size: 13px;
    font-weight: 500;
    background: transparent;
}

/* Menu xổ xuống (QMenu) cho Dark Theme */
QMenu {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 4px 2px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 24px 6px 30px;
    border-radius: 4px;
    margin: 1px 2px;
}

QMenu::item:selected {
    background-color: #313244;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #6c7086;
}

QMenu::separator {
    height: 1px;
    background-color: #313244;
    margin: 4px 6px;
}

/* Dấu tích checkbox/radio tùy biến cho QMenu */
QMenu::indicator {
    width: 14px;
    height: 14px;
    left: 8px;
}

QMenu::indicator:checked {
    image: url(:/icons/menu_check_dark.svg);
}

QMenu::indicator:unchecked {
    image: none;
}

/* ==============================================================================
 * Các Nút Điều Khiển Cửa Sổ (Window Controls)
 * ============================================================================== */
#WinMinBtn, #WinMaxBtn {
    background: transparent;
    border: none;
    border-radius: 0px;
}

#WinMinBtn:hover, #WinMaxBtn:hover {
    background-color: #313244;
}

#WinMinBtn:pressed, #WinMaxBtn:pressed {
    background-color: #45475a;
}

/* Nút Close: Màu đỏ chuẩn với icon dấu X trắng nổi bật khi hover/pressed */
#WinCloseBtn, #DialogCloseBtn, #AboutCloseIconBtn {
    background: transparent;
    border: none;
    border-radius: 0px;
}

#WinCloseBtn:hover, #DialogCloseBtn:hover, #AboutCloseIconBtn:hover {
    background-color: #e81123;
    qproperty-icon: url(:/icons/win_close_white.svg);
}

#WinCloseBtn:pressed, #DialogCloseBtn:pressed, #AboutCloseIconBtn:pressed {
    background-color: #c40e1d;
    qproperty-icon: url(:/icons/win_close_white.svg);
}

/* ==============================================================================
 * Vùng Chứa Nội Dung (ContentArea) & Khung Thẻ (Cards)
 * ============================================================================== */
#ContentArea {
    background-color: #1e1e2e;
}

#CardWidget {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 24px;
}

#CardWidget QLabel {
    background: transparent;
}

#CardTitleLabel {
    color: #ffffff;
    font-size: 18px;
    font-weight: bold;
    background: transparent;
}

#CardDescLabel {
    color: #a6adc8;
    font-size: 13px;
    background: transparent;
}

/* ==============================================================================
 * Các Nút Bấm Thao Tác (Buttons)
 * ============================================================================== */
QPushButton {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 12.5px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #45475a;
    border-color: #585b70;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #585b70;
    border-color: #585b70;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #1e1e2e;
    border-color: #313244;
    color: #6c7086;
}

QPushButton#PrimaryButton {
    background-color: #ffffff;
    color: #11111b;
    border: 1px solid #ffffff;
    font-weight: 600;
}

QPushButton#PrimaryButton:hover {
    background-color: #eff1f5;
    border-color: #eff1f5;
    color: #11111b;
}

QPushButton#PrimaryButton:pressed {
    background-color: #e6e9ef;
    border-color: #e6e9ef;
    color: #11111b;
}

QPushButton#PrimaryButton:disabled {
    background-color: #313244;
    border-color: #45475a;
    color: #6c7086;
}

QPushButton#DangerButton {
    background-color: #24273a;
    color: #f38ba8;
    border: 1px solid #45475a;
    font-weight: 500;
}

QPushButton#DangerButton:hover {
    background-color: rgba(243, 139, 168, 0.18);
    border-color: #f38ba8;
    color: #f38ba8;
}

QPushButton#DangerButton:pressed {
    background-color: #f38ba8;
    border-color: #f38ba8;
    color: #11111b;
}

/* ==============================================================================
 * Ô Nhập Liệu (Input Fields)
 * ============================================================================== */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 5px;
    padding: 6px 10px;
    font-size: 13px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #cdd6f4;
    background-color: #1e1e2e;
}

/* ==============================================================================
 * Thanh Cuộn Tối Giản (QScrollBar)
 * ============================================================================== */
QScrollBar:vertical {
    background-color: #1e1e2e;
    width: 8px;
    margin: 0;
    border-radius: 4px;
}

QScrollBar:handle:vertical {
    background-color: #313244;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar:handle:vertical:hover {
    background-color: #45475a;
}

QScrollBar:add-line:vertical, QScrollBar:sub-line:vertical,
QScrollBar:add-page:vertical, QScrollBar:sub-page:vertical {
    background: none;
    border: none;
}

QScrollBar:horizontal {
    background-color: #1e1e2e;
    height: 8px;
    margin: 0;
    border-radius: 4px;
}

QScrollBar:handle:horizontal {
    background-color: #313244;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar:handle:horizontal:hover {
    background-color: #45475a;
}

QScrollBar:add-line:horizontal, QScrollBar:sub-line:horizontal,
QScrollBar:add-page:horizontal, QScrollBar:sub-page:horizontal {
    background: none;
    border: none;
}

/* ==============================================================================
 * Thanh Trạng Thái (StatusBar)
 * ============================================================================== */
#StatusBar, QStatusBar {
    background-color: #181825;
    border-top: 1px solid #313244;
    color: #a6adc8;
    font-size: 11px;
    min-height: 24px;
}

QStatusBar::item {
    border: none;
}

#StatusBar QLabel {
    color: #6c7086;
    font-size: 11px;
    padding: 2px 4px;
    background: transparent;
}

/* ==============================================================================
 * Cấu Trúc 3 Cột (MainThreeColumnSplitter)
 * ============================================================================== */
#MainThreeColumnSplitter {
    background-color: #1e1e2e;
}

#MainThreeColumnSplitter::handle {
    background-color: #313244;
    width: 1px;
}

#MainThreeColumnSplitter::handle:hover {
    background-color: #585b70;
}

/* Header Action Buttons */
#HeaderSidebarToggleBtn, #HeaderThemeToggleBtn, #HeaderSettingsBtn, #HeaderAboutBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px;
}

#HeaderSidebarToggleBtn:hover, #HeaderThemeToggleBtn:hover, #HeaderSettingsBtn:hover, #HeaderAboutBtn:hover {
    background-color: #313244;
}

#HeaderSidebarToggleBtn:pressed, #HeaderThemeToggleBtn:pressed, #HeaderSettingsBtn:pressed, #HeaderAboutBtn:pressed {
    background-color: #45475a;
}

/* 1. Cột 1: SidebarView */
#SidebarView,
#SidebarExpandedContainer,
#SidebarCollapsedContainer {
    background-color: #181825;
    background: #181825;
    border-right: 1px solid #313244;
}

#SidebarToggleBtn, #SidebarNewVaultBtn {
    background-color: #232634;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 0;
}

#SidebarToggleBtn:hover, #SidebarNewVaultBtn:hover {
    background-color: #313244;
    border-color: #585b70;
}

#SidebarCompactVaultBtn {
    background-color: #232634;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 4px;
}

#SidebarCompactVaultBtn:hover {
    background-color: #313244;
    border-color: #585b70;
}

#SidebarCompactList {
    background: transparent;
    border: none;
    outline: none;
}

#SidebarCompactList::item {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

#SidebarCompactLockBtn {
    background-color: #232634;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 6px;
    color: #f38ba8;
}

#SidebarCompactLockBtn:hover {
    background-color: #313244;
    border-color: #f38ba8;
}

#SidebarHeaderWidget {
    background: transparent;
    border-bottom: 1px solid #313244;
}

#VaultProfileComboBox {
    background-color: #232634;
    border: 1px solid #313244;
    border-radius: 6px;
    padding-left: 8px;
    padding-right: 24px;
    color: #cdd6f4;
    font-size: 13px;
    font-weight: 600;
    min-height: 32px;
    max-height: 32px;
}

#VaultProfileComboBox:hover {
    background-color: #2a2e3f;
    border-color: #585b70;
}

#VaultProfileComboBox:focus {
    border-color: #6c7086;
}

#VaultProfileComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 20px;
    border: none;
    margin-right: 4px;
}

#VaultProfileComboBox::down-arrow {
    image: url(:/icons/chevron_down_dark.svg);
    width: 12px;
    height: 12px;
}

#LockBtnText {
    color: #f38ba8;
    font-weight: 600;
    font-size: 13px;
    background: transparent;
}

#VaultSwitchMenu {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 4px;
    color: #cdd6f4;
}

#SidebarNavList {
    background: transparent;
    border: none;
    outline: none;
    padding: 4px 0;
}

#SidebarFooterWidget {
    background: transparent;
    border-top: 1px solid #313244;
}

#SidebarLockBtn {
    background-color: transparent;
    border: 1px solid rgba(243, 139, 168, 0.25);
    border-radius: 6px;
    padding: 0;
    min-height: 32px;
    color: #f38ba8;
    font-weight: 600;
    text-align: left;
}

#SidebarLockBtn:hover {
    background-color: rgba(243, 139, 168, 0.12);
    border-color: #f38ba8;
}

/* 2. Cột 2: ItemListView */
#ItemListView {
    background-color: #1e1e2e;
    background: #1e1e2e;
    border-right: 1px solid #313244;
}

#ItemListSearchEdit {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 0 10px;
    color: #cdd6f4;
    font-size: 13px;
    min-height: 28px;
    max-height: 28px;
}

#ItemListSearchEdit:focus {
    border-color: #cdd6f4;
    background-color: #1e1e2e;
}

QComboBox {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 0px 24px 0px 10px;
    color: #cdd6f4;
    font-size: 12px;
    font-weight: 500;
    min-height: 32px;
    max-height: 32px;
}

QComboBox:hover {
    border-color: #585b70;
}

QComboBox:focus {
    border-color: #cdd6f4;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    border-left: none;
}

QComboBox::down-arrow {
    image: url(:/icons/chevron_down_dark.svg);
    width: 10px;
    height: 10px;
}

QComboBoxPrivateContainer {
    background-color: transparent;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #181825;
    color: #cdd6f4;
    selection-background-color: #363d59;
    selection-color: #ffffff;
    border: 1px solid #45475a;
    border-radius: 8px;
    padding: 6px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 10px;
    border-radius: 6px;
    color: #cdd6f4;
    font-size: 12px;
    font-weight: 500;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background-color: #363d59;
    color: #ffffff;
}

/* ==============================================================================
 * Hộp Chọn (QCheckBox)
 * ============================================================================== */
QCheckBox {
    color: #cdd6f4;
    font-size: 12px;
    spacing: 8px;
    background: transparent;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #45475a;
    background-color: #232634;
}

QCheckBox::indicator:hover {
    border-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #ffffff;
    border-color: #ffffff;
    image: url(:/icons/checkbox_check_dark.svg);
}

#ItemListNewBtn {
    background-color: #232634;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 0;
    min-height: 28px;
    max-height: 28px;
    min-width: 28px;
    max-width: 28px;
}

#ItemListNewBtn:hover {
    background-color: #313244;
    border-color: #ffffff;
}

#ItemListNewBtn:pressed {
    background-color: #45475a;
    border-color: #ffffff;
}

#ItemCardListView {
    background: transparent;
    border: none;
    outline: none;
}

#ItemListStack {
    background: transparent;
    border: none;
}

#ItemListEmptyWidget {
    background: transparent;
    border: none;
}

#ItemListEmptyIconContainer {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 16px;
}

#ItemListEmptyTitle {
    color: #cdd6f4;
    font-size: 14px;
    font-weight: 700;
}

#ItemListEmptyDesc {
    color: #a6adc8;
    font-size: 12px;
    line-height: 1.4;
}

#ItemListEmptyActionBtn {
    background-color: #ffffff;
    color: #11111b;
    border: 1px solid #ffffff;
    border-radius: 6px;
    padding: 0 16px;
    font-size: 12px;
    font-weight: 700;
    min-height: 32px;
    max-height: 32px;
}

#ItemListEmptyActionBtn:hover {
    background-color: #eff1f5;
    border-color: #eff1f5;
    color: #11111b;
}

#ItemListEmptyActionBtn:pressed {
    background-color: #dce0e8;
    border-color: #dce0e8;
    color: #11111b;
}

/* 3. Cột 3: DetailInspectorView */
#DetailInspectorView,
#DetailScrollArea,
#DetailScrollViewport,
#DetailContentContainer {
    background-color: #1e1e2e;
    background: #1e1e2e;
    border: none;
}

#EmptyStateTitle {
    color: #cdd6f4;
    font-size: 18px;
    font-weight: bold;
}

#EmptyStateDesc {
    color: #a6adc8;
    font-size: 13px;
    line-height: 1.5;
}

#EmptyStateIconContainer {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 20px;
}

#EmptyStateCard {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 12px;
}

#EmptyStateActionLabel {
    color: #cdd6f4;
    font-size: 13px;
    font-weight: 500;
}

#EmptyStateKeycap {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-bottom: 2px solid #585b70;
    border-radius: 5px;
    padding: 2px 7px;
    font-size: 11px;
    font-weight: 600;
    min-width: 22px;
}

#EmptyStateKeycapPlus {
    color: #6c7086;
    font-size: 11px;
    font-weight: bold;
}

#EmptyStateDivider {
    background-color: #2b2b3d;
    max-height: 1px;
    min-height: 1px;
    border: none;
}

#EmptyStateActionBtn {
    background-color: #ffffff;
    color: #11111b;
    border: 1px solid #ffffff;
    border-radius: 8px;
    padding: 0 24px;
    font-size: 13px;
    font-weight: 700;
    min-height: 38px;
    max-height: 38px;
}

#EmptyStateActionBtn:hover {
    background-color: #eff1f5;
    border-color: #eff1f5;
    color: #11111b;
}

#EmptyStateActionBtn:pressed {
    background-color: #dce0e8;
    border-color: #dce0e8;
    color: #11111b;
}

#DetailHeaderCard {
    background-color: #181825;
    background: #181825;
    border: 1px solid #313244;
    border-radius: 8px;
}

#DetailHeaderIcon {
    background-color: #232634;
    border-radius: 8px;
}

#DetailHeaderTitle {
    color: #cdd6f4;
}

#DetailHeaderTitleInput {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 4px 10px;
    color: #cdd6f4;
    font-size: 15px;
    font-weight: 600;
    selection-background-color: #45475a;
    selection-color: #ffffff;
}

#DetailHeaderTitleInput:focus {
    border-color: #cdd6f4;
    background-color: #181825;
}

#DetailCategoryBadge {
    background-color: #313244;
    color: #ffffff;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

#DetailCategoryCombo {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 2px 22px 2px 8px;
    color: #cdd6f4;
    font-size: 12px;
    font-weight: 500;
}

#DetailCategoryCombo:hover {
    border-color: #45475a;
    background-color: #1e1e2e;
}

#DetailCategoryCombo:focus {
    border-color: #cdd6f4;
}

#DetailCategoryCombo::drop-down {
    border: none;
    width: 18px;
}

#DetailCategoryCombo::down-arrow {
    image: url(:/icons/chevron_down_dark.svg);
    width: 10px;
    height: 10px;
}

#DetailUpdatedLabel {
    color: #6c7086;
    font-size: 11px;
}

#DetailHeaderFavBtn {
    background-color: #232634;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 0;
    color: #cdd6f4;
}

#DetailHeaderFavBtn:hover {
    background-color: #313244;
    border-color: #585b70;
}

#DetailHeaderEditBtn {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 0 14px;
    color: #cdd6f4;
    font-size: 13px;
    font-weight: 500;
}

#DetailHeaderEditBtn:hover {
    background-color: #45475a;
    border-color: #585b70;
    color: #ffffff;
}

#DetailHeaderEditBtn:pressed {
    background-color: #585b70;
    border-color: #585b70;
}

#DetailHeaderCancelBtn {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 0 16px;
    font-size: 13px;
    font-weight: 500;
}

#DetailHeaderCancelBtn:hover {
    background-color: #45475a;
    border-color: #585b70;
    color: #ffffff;
}

#DetailHeaderCancelBtn:pressed {
    background-color: #585b70;
    border-color: #585b70;
}

#DetailHeaderSaveBtn {
    background-color: #ffffff;
    color: #11111b;
    border: 1px solid #ffffff;
    border-radius: 6px;
    padding: 0 18px;
    font-size: 13px;
    font-weight: 600;
}

#DetailHeaderSaveBtn:hover {
    background-color: #eff1f5;
    border-color: #eff1f5;
    color: #11111b;
}

#DetailHeaderSaveBtn:pressed {
    background-color: #e6e9ef;
    border-color: #e6e9ef;
    color: #11111b;
}

#TotpFieldWidget {
    background: transparent;
    border: none;
}

#TotpSectionHeader {
    color: #a6adc8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

#TotpTimerLabel {
    color: #a6e3a1;
    font-weight: bold;
    font-size: 12px;
}

#TotpCodeDisplay {
    color: #cdd6f4;
    letter-spacing: 2px;
}

#TotpCopyBtn {
    background: transparent;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 4px;
}

#TotpCopyBtn:hover {
    background-color: #313244;
    border-color: #585b70;
}

#TotpCopyBtn:pressed {
    background-color: #45475a;
    border-color: #585b70;
}

#TotpProgressBar {
    background-color: #313244;
    border-radius: 2px;
}

#TotpProgressBar::chunk {
    background-color: #a6e3a1;
    border-radius: 2px;
}

#DetailSectionCard {
    background-color: #181825;
    background: #181825;
    border: 1px solid #313244;
    border-radius: 10px;
}

#DetailSectionHeader {
    color: #ffffff;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 0.8px;
    padding-bottom: 2px;
}

#FieldRowDivider {
    background-color: #2a2b3d;
    min-height: 1px;
    max-height: 1px;
    border: none;
    margin: 2px 6px;
}

#FieldRowWidget, #CustomFieldRowWidget, #TotpFieldWidget {
    background: transparent;
    border: none;
}

#FieldRowLabel {
    color: #a6adc8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

#FieldRowValue {
    color: #cdd6f4;
    font-size: 13px;
    font-weight: 500;
}

#FieldRowInput {
    background-color: #232634;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 6px 10px;
    color: #ffffff;
    font-size: 13px;
}

#FieldRowInput:focus {
    border-color: #cdd6f4;
}

#FieldRowActionBtn {
    background: transparent;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 4px;
}

#FieldRowActionBtn:hover {
    background-color: #313244;
    border-color: #585b70;
}

#FieldRowActionBtn:pressed {
    background-color: #45475a;
    border-color: #585b70;
}

#CustomFieldKindCombo {
    background-color: #232634;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 2px 8px;
    color: #cdd6f4;
    font-size: 12px;
}

#CustomFieldKindCombo:focus {
    border-color: #cdd6f4;
}

#CustomFieldBoolEdit {
    color: #cdd6f4;
    font-size: 13px;
    font-weight: 500;
    spacing: 8px;
    padding: 2px 4px;
}

#CustomFieldBoolEdit::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #45475a;
    background-color: #232634;
}

#CustomFieldBoolEdit::indicator:hover {
    border-color: #ffffff;
}

#CustomFieldBoolEdit::indicator:checked {
    background-color: #ffffff;
    border-color: #ffffff;
    image: url(:/icons/checkbox_check_dark.svg);
}

#CustomFieldDateEdit {
    background-color: #232634;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 4px 10px;
    color: #ffffff;
    font-size: 13px;
}

#CustomFieldDateEdit:focus {
    border-color: #cdd6f4;
}

#CustomFieldDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: none;
}

#CustomFieldDateEdit::down-arrow {
    image: url(:/icons/chevron_down_dark.svg);
    width: 12px;
    height: 12px;
}

/* QCalendarWidget Theme (Dark Mocha) */
QCalendarWidget {
    background-color: #181825;
    border: 1px solid #45475a;
    border-radius: 8px;
    min-width: 260px;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #181825;
    border-bottom: 1px solid #313244;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 34px;
    padding: 2px 4px;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #cdd6f4;
    font-size: 12px;
    font-weight: 600;
    margin: 2px;
    padding: 2px 6px;
}

QCalendarWidget QToolButton:hover {
    background-color: #313244;
    border-color: #45475a;
    color: #ffffff;
}

QCalendarWidget QToolButton:pressed {
    background-color: #45475a;
}

QCalendarWidget #qt_calendar_prevmonth {
    qproperty-icon: url(:/icons/chevron_left_dark.svg);
    icon-size: 12px 12px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
}

QCalendarWidget #qt_calendar_nextmonth {
    qproperty-icon: url(:/icons/chevron_right_dark.svg);
    icon-size: 12px 12px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
}

QCalendarWidget #qt_calendar_monthbutton,
QCalendarWidget #qt_calendar_yearbutton {
    color: #cdd6f4;
    font-weight: 600;
    font-size: 12px;
    padding: 2px 8px;
}

QCalendarWidget QSpinBox {
    background-color: #232634;
    color: #ffffff;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 2px 4px;
    font-size: 12px;
    selection-background-color: #ffffff;
    selection-color: #11111b;
}

QCalendarWidget QMenu {
    background-color: #181825;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 4px;
    color: #cdd6f4;
}

QCalendarWidget QMenu::item {
    padding: 4px 12px;
    border-radius: 4px;
}

QCalendarWidget QMenu::item:selected {
    background-color: #363d59;
    color: #ffffff;
}

QCalendarWidget QTableView {
    background-color: #181825;
    selection-background-color: #ffffff;
    selection-color: #11111b;
    border: none;
    outline: none;
    alternate-background-color: #181825;
}

QCalendarWidget QTableView:enabled {
    color: #cdd6f4;
}

QCalendarWidget QTableView:disabled {
    color: #6c7086;
}

QCalendarWidget QTableView::item {
    border-radius: 4px;
    padding: 2px;
}

QCalendarWidget QTableView::item:hover {
    background-color: #313244;
    color: #ffffff;
}

QCalendarWidget QTableView::item:selected {
    background-color: #ffffff;
    color: #11111b;
    font-weight: bold;
}

QCalendarWidget QHeaderView {
    background-color: #181825;
    border: none;
}

QCalendarWidget QHeaderView::section {
    background-color: #181825;
    color: #a6adc8;
    border: none;
    padding: 4px;
    font-size: 11px;
    font-weight: 600;
}

#CustomFieldDeleteBtn {
    background: transparent;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 4px;
}

#CustomFieldDeleteBtn:hover {
    background-color: #452835;
    border-color: #f38ba8;
}

#CustomFieldAddBtn, #AddTotpBtn {
    background-color: #1e1e2e;
    border: 1px dashed #45475a;
    border-radius: 6px;
    color: #ffffff;
    font-weight: 600;
    font-size: 12px;
}

#CustomFieldAddBtn:hover, #AddTotpBtn:hover {
    background-color: #313244;
    border-color: #ffffff;
    color: #ffffff;
}

/* 4. About Dialog */
#AboutDialogCard {
    background-color: #181825;
    border: 1px solid #45475a;
    border-radius: 0px;
}

#AboutDialogHeader {
    background-color: #11111b;
    border: 1px solid #45475a;
    border-radius: 0px;
    padding: 8px 12px;
}

#AboutDialogTitle {
    color: #cdd6f4;
    font-size: 13px;
    font-weight: 600;
}

#AboutTabWidget::pane {
    border: 1px solid #313244;
    border-radius: 8px;
    background-color: #181825;
    top: -1px;
}

#AboutTabWidget QTabBar::tab {
    background-color: #1e1e2e;
    color: #a6adc8;
    border: 1px solid #313244;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 16px;
    margin-right: 4px;
    font-size: 12px;
    font-weight: 500;
}

#AboutTabWidget QTabBar::tab:hover {
    background-color: #26293b;
    color: #bac2de;
}

#AboutTabWidget QTabBar::tab:selected,
#AboutTabWidget QTabBar::tab:selected:hover {
    background-color: #181825;
    color: #cdd6f4;
    border-color: #45475a;
    font-weight: 600;
}

#AboutMetaLabelKey {
    color: #a6adc8;
    font-size: 12px;
    font-weight: 600;
}

#AboutMetaLabelVal {
    color: #cdd6f4;
    font-size: 12px;
}

#AboutLicenseView {
    background-color: #11111b;
    border: 1px solid #313244;
    border-radius: 6px;
    color: #bac2de;
    font-family: monospace;
    font-size: 11px;
    padding: 8px;
}

#AboutBottomCloseBtn {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 6px;
    color: #cdd6f4;
    padding: 6px 20px;
    font-size: 12px;
    font-weight: 500;
}

#AboutBottomCloseBtn:hover {
    background-color: #45475a;
    border-color: #585b70;
    color: #ffffff;
}

#AboutBottomCloseBtn:pressed {
    background-color: #585b70;
    border-color: #585b70;
    color: #ffffff;
}

/* 6. Onboarding Wizard & Lock Screen Cards */
#OnboardingWizardView, #LockScreenView {
    background-color: #1e1e2e;
}

#LockScreenCard {
    background-color: #181825;
    border: 1px solid #45475a;
    border-radius: 12px;
}

#RecoveryDialogCard, #NewVaultCard {
    background-color: #181825;
    border: 1px solid #45475a;
    border-radius: 0px;
}

/* --- Onboarding Wizard (Split Card Design) --- */
#OnboardingCard {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 16px;
}

#OnboardingSidebar {
    background-color: #11111b;
    border-top-left-radius: 15px;
    border-bottom-left-radius: 15px;
    border-right: 1px solid #313244;
}

#OnboardingContentPanel {
    background-color: #181825;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
}

#OnboardingDivider {
    background-color: #313244;
}

#OnboardingSidebarTitle {
    color: #cdd6f4;
}

#OnboardingSidebarSub {
    color: #a6adc8;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

#OnboardingBadge {
    color: #ffffff;
    font-weight: 700;
    letter-spacing: 0.8px;
}

#OnboardingTitle {
    color: #cdd6f4;
}

#OnboardingDesc {
    color: #a6adc8;
}

#OnboardingLabel {
    color: #bac2de;
}

#OnboardingStepItem {
    border-radius: 8px;
    padding: 6px 10px;
    background-color: transparent;
}

#OnboardingStepItemActive {
    border-radius: 8px;
    padding: 6px 10px;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
}

#OnboardingTrustBadge {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 8px 10px;
}

#OnboardingTrustTitle {
    color: #cdd6f4;
}

#OnboardingTrustSub {
    color: #a6adc8;
}

#OnboardingFeatureCard {
    background-color: #1e1e2e;
    border: 1px solid #313244;
    border-radius: 10px;
    padding: 10px 14px;
}

#OnboardingFeatureCard:hover {
    border-color: #45475a;
    background-color: #232634;
}

#OnboardingFeatureTitle {
    color: #cdd6f4;
}

#OnboardingFeatureDesc {
    color: #a6adc8;
}

#OnboardingInputContainer {
    background-color: #1e1e2e;
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 0 4px 0 10px;
}

#OnboardingInputContainer:focus-within {
    border-color: #ffffff;
}

#OnboardingInput {
    background: transparent;
    border: none;
    color: #cdd6f4;
    font-size: 13px;
    selection-background-color: #45475a;
    selection-color: #ffffff;
}

#OnboardingEyeBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px;
}

#OnboardingEyeBtn:hover {
    background-color: #313244;
}

#OnboardingWarningBox {
    background-color: rgba(249, 226, 175, 0.08);
    border: 1px solid rgba(249, 226, 175, 0.25);
    border-radius: 8px;
    padding: 10px 14px;
}

#OnboardingBiometricCard {
    background-color: #1e1e2e;
    border: 1px solid #313244;
    border-radius: 10px;
    padding: 12px 14px;
}

#OnboardingBiometricCard:hover {
    border-color: #45475a;
}

#OnboardingSummaryBox {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 6px;
}

#OnboardingSummaryItem {
    color: #cdd6f4;
    font-size: 11px;
    font-weight: 500;
}

#OnboardingSecondaryBtn {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 6px;
    color: #cdd6f4;
    font-size: 13px;
    font-weight: 500;
    padding: 0 16px;
}

#OnboardingSecondaryBtn:hover {
    background-color: #45475a;
    border-color: #585b70;
    color: #ffffff;
}

#OnboardingSecondaryBtn:pressed {
    background-color: #585b70;
    border-color: #585b70;
}

#OnboardingPrimaryBtn {
    background-color: #ffffff;
    border: 1px solid #ffffff;
    border-radius: 6px;
    color: #11111b;
    font-size: 13px;
    font-weight: 600;
    padding: 0 20px;
}

#OnboardingPrimaryBtn:hover {
    background-color: #eff1f5;
    border-color: #eff1f5;
    color: #11111b;
}

#OnboardingPrimaryBtn:pressed {
    background-color: #e6e9ef;
    border-color: #e6e9ef;
    color: #11111b;
}

#OnboardingPrimaryBtn:disabled {
    background-color: #313244;
    border-color: #45475a;
    color: #6c7086;
}

#RecoveryBox {
    background-color: #11111b;
    border: 1px solid #313244;
    border-radius: 8px;
}

#RecoveryKeyDisplay {
    font-family: "JetBrains Mono", "Cascadia Code", "Fira Code", monospace;
    font-size: 15px;
    font-weight: 700;
    color: #a6e3a1;
    letter-spacing: 1.5px;
    background: transparent;
    border: none;
    padding: 6px 0;
}

#RecoveryActionBtn {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
}

#RecoveryActionBtn:hover {
    background-color: #45475a;
    border-color: #585b70;
    color: #ffffff;
}

#RecoveryActionBtn:pressed {
    background-color: #585b70;
    border-color: #585b70;
}

#LockPasswordContainer {
    background-color: #1e1e2e;
    border: 1px solid #45475a;
    border-radius: 8px;
}

#LockPasswordContainer:focus-within {
    border-color: #ffffff;
}

#LockPasswordInput {
    background: transparent;
    border: none;
    color: #cdd6f4;
    font-size: 14px;
    padding-left: 10px;
}

#LockRevealBtn, #LockBiometricBtn {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 6px;
}

#LockRevealBtn:hover, #LockBiometricBtn:hover {
    background-color: #45475a;
    border-color: #585b70;
}

#LockRevealBtn:pressed, #LockBiometricBtn:pressed {
    background-color: #585b70;
    border-color: #585b70;
}

/* 7. Settings Dialog & Sidebar Footer Buttons */
#SidebarCollapseBtn {
    background-color: transparent;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 0;
}

#SidebarCollapseBtn:hover {
    background-color: #313244;
    border-color: #45475a;
}

#SettingsDialogCard {
    background-color: #181825;
    border: 1px solid #45475a;
    border-radius: 0px;
}

#SettingsDialogHeader, #NewVaultHeader, #RecoveryDialogHeader {
    background-color: #11111b;
    border: 1px solid #45475a;
    border-radius: 0px;
}

/* 7. Notification & Message Dialogs */
#NotificationDialogCard {
    background-color: #181825;
    border: 1px solid #45475a;
    border-radius: 0px;
}

#NotificationDialogHeader {
    background-color: #11111b;
    border: none;
    border-bottom: 1px solid #313244;
    border-radius: 0px;
}

#NotificationDialogTitle {
    color: #cdd6f4;
    font-size: 13px;
    font-weight: 600;
}

#NotificationIconContainer {
    background-color: #1e1e2e;
    border: 1px solid #313244;
    border-radius: 8px;
}

#NotificationDialogMessage {
    color: #cdd6f4;
    font-size: 13px;
    line-height: 1.4;
}

#NotificationCancelBtn {
    background-color: #232634;
    border: 1px solid #313244;
    border-radius: 6px;
    color: #cdd6f4;
    padding: 0 16px;
    font-size: 12px;
    font-weight: 600;
}

#NotificationCancelBtn:hover {
    background-color: #313244;
    border-color: #45475a;
    color: #ffffff;
}

#NotificationCancelBtn:pressed {
    background-color: #1e1e2e;
}

#NotificationPrimaryBtn {
    background-color: #ffffff;
    border: 1px solid #ffffff;
    border-radius: 6px;
    color: #11111b;
    padding: 0 18px;
    font-size: 12px;
    font-weight: 700;
}

#NotificationPrimaryBtn:hover {
    background-color: #eff1f5;
    border-color: #eff1f5;
}

#NotificationPrimaryBtn:pressed {
    background-color: #dce0e8;
    border-color: #dce0e8;
}

#NotificationDangerBtn {
    background-color: #ed8796;
    border: 1px solid #ed8796;
    border-radius: 6px;
    color: #11111b;
    padding: 0 18px;
    font-size: 12px;
    font-weight: 700;
}

#NotificationDangerBtn:hover {
    background-color: #ee99a0;
    border-color: #ee99a0;
}

#NotificationDangerBtn:pressed {
    background-color: #ea76cb;
    border-color: #ea76cb;
}

#SettingsDialogTitle, #NewVaultTitle, #RecoveryDialogTitle {
    color: #cdd6f4;
    font-size: 13px;
    font-weight: 600;
}

#SettingsBodyWidget {
    background-color: #181825;
    border-left: 1px solid #45475a;
    border-right: 1px solid #45475a;
    border-bottom: 1px solid #45475a;
}

#SettingsNavList {
    background-color: #181825;
    border: none;
    border-left: 1px solid #45475a;
    border-bottom: 1px solid #45475a;
    padding: 8px 6px;
    outline: none;
}

#SettingsNavList::item {
    color: #a6adc8;
    border-radius: 6px;
    padding: 7px 10px;
    margin-bottom: 2px;
    font-size: 12px;
    font-weight: 500;
}

#SettingsNavList::item:hover {
    background-color: #1e1e2e;
    color: #cdd6f4;
}

#SettingsNavList::item:selected {
    background-color: #313244;
    color: #ffffff;
    font-weight: 600;
}

#SettingsRightPane {
    background-color: #1e1e2e;
    background: #1e1e2e;
    border-top: none;
    border-left: none;
    border-right: 1px solid #45475a;
    border-bottom: 1px solid #45475a;
}

#SettingsScrollArea,
#SettingsScrollViewport,
#SettingsTabStack,
#SettingsTabStack > QWidget {
    background-color: #1e1e2e;
    background: #1e1e2e;
    border: none;
}

#SettingSectionCard {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 8px;
}

#SettingSectionCard QLabel {
    background: transparent;
}

#SettingsVerticalDivider {
    color: #45475a;
    background-color: #45475a;
}

#SettingRowTitle {
    font-size: 13px;
    font-weight: 600;
    color: #cdd6f4;
}

#SettingRowDesc {
    font-size: 11.5px;
    color: #a6adc8;
}

#SettingSectionTitle {
    font-size: 11px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.8px;
    margin-bottom: 2px;
}

#SettingsListItemCard {
    background-color: #1e1e2e;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 4px;
}

#SettingsListItemTitle {
    font-size: 13px;
    font-weight: 600;
    color: #cdd6f4;
}

#SettingsListItemDesc {
    font-size: 11px;
    color: #a6adc8;
}

#SettingsDefaultBadge {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    font-size: 11px;
    font-weight: 600;
    border-radius: 4px;
    padding: 3px 8px;
}

#SshSnippetBox {
    background-color: #11111b;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 10px;
}

#SshSnippetHint {
    font-size: 11px;
    color: #a6adc8;
}

#SshSnippetCode {
    font-family: monospace;
    font-size: 12px;
    color: #a6e3a1;
}

#DialogDescLabel, #LockSubtitleLabel, #AboutDescLabel {
    color: #a6adc8;
    font-size: 11.5px;
}

#DialogFieldLabel {
    font-size: 11px;
    font-weight: 600;
    color: #bac2de;
}

#DialogErrorLabel {
    color: #ef4444;
    font-size: 11px;
    font-weight: 500;
}

#LockForgotBtn {
    color: #a6adc8;
    font-size: 11.5px;
    text-decoration: underline;
    background: transparent;
    border: none;
}

#LockForgotBtn:hover {
    color: #ffffff;
}

#AboutTaglineLabel {
    color: #a6adc8;
    font-weight: 500;
    font-size: 11px;
}

#AboutDividerLine {
    background-color: #313244;
    max-height: 1px;
}

#IconPickerBtn {
    background-color: #1e1e2e;
    border: 1px solid #313244;
    border-radius: 6px;
}

#IconPickerBtn:hover {
    background-color: #26293b;
    border-color: #45475a;
}

#IconPickerBtn[selected="true"] {
    background-color: #313244;
    border: 2px solid #ffffff;
    border-radius: 6px;
}

#DetailHeaderDeleteBtn {
    background-color: #232634;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 0 10px;
    color: #f38ba8;
    font-size: 12.5px;
    font-weight: 500;
}

#DetailHeaderDeleteBtn:hover {
    background-color: rgba(243, 139, 168, 0.15);
    border-color: #f38ba8;
    color: #f38ba8;
}

#DetailHeaderDeleteBtn:pressed {
    background-color: #f38ba8;
    border-color: #f38ba8;
    color: #11111b;
}

#DetailHeaderRestoreBtn {
    background-color: #232634;
    border: 1px solid #a6e3a1;
    border-radius: 6px;
    padding: 0 12px;
    color: #a6e3a1;
    font-size: 12.5px;
    font-weight: 600;
}

#DetailHeaderRestoreBtn:hover {
    background-color: rgba(166, 227, 161, 0.15);
    border-color: #a6e3a1;
}

#DetailHeaderRestoreBtn:pressed {
    background-color: #a6e3a1;
    border-color: #a6e3a1;
    color: #11111b;
}

#FieldRowGenerateBtn {
    background-color: #232634;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 0 10px;
    color: #ffffff;
    font-size: 11.5px;
    font-weight: 600;
}

#FieldRowGenerateBtn:hover {
    background-color: #313244;
    border-color: #ffffff;
    color: #ffffff;
}

#FieldRowGenerateBtn:pressed {
    background-color: #45475a;
    border-color: #ffffff;
    color: #ffffff;
}

/* PairingDialog */
#PairingDialogCard {
    background-color: #1e1e2e;
    border: 1px solid #45475a;
    border-radius: 12px;
}

#PairingDialogTitle {
    color: #cdd6f4;
    font-size: 16px;
    font-weight: 700;
}

#PairingDialogDesc {
    color: #a6adc8;
    font-size: 12.5px;
    line-height: 1.4;
}

#PairingPinBox {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 8px;
}

#PairingPinLabel {
    color: #89b4fa;
    font-size: 32px;
    font-weight: 800;
    font-family: monospace;
    letter-spacing: 6px;
}

#PairingTimerLabel {
    color: #a6adc8;
    font-size: 12px;
}

#PairingCopyBtn {
    background-color: #89b4fa;
    color: #11111b;
    border: none;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 700;
    padding: 0 16px;
}

#PairingCopyBtn:hover {
    background-color: #b4befe;
}

#PairingCloseBtn {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    padding: 0 16px;
}

#PairingCloseBtn:hover {
    background-color: #45475a;
}

/* Browser Empty State */
#BrowserEmptyCard {
    background-color: #181825;
    border: 1px dashed #313244;
    border-radius: 8px;
}

#BrowserEmptyTitle {
    color: #cdd6f4;
    font-size: 13.5px;
    font-weight: 700;
}

#BrowserEmptyDesc {
    color: #a6adc8;
    font-size: 12px;
    line-height: 1.4;
}

/* Browser Integration Tab */
#BrowserHintBox {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 10px 14px;
}

#BrowserHintText {
    color: #a6adc8;
    font-size: 11.5px;
    line-height: 1.45;
}

#BrowserItemCard {
    background-color: #1e1e2e;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 8px 12px;
}

#BrowserItemCard:hover {
    border-color: #45475a;
    background-color: #242438;
}

#BrowserItemTitle {
    color: #cdd6f4;
    font-size: 13px;
    font-weight: 600;
}

#BrowserItemDesc {
    color: #a6adc8;
    font-size: 11px;
}

#BrowserConnectedBadge {
    background-color: rgba(166, 227, 161, 0.15);
    color: #a6e3a1;
    border: 1px solid rgba(166, 227, 161, 0.35);
    border-radius: 4px;
    font-size: 10.5px;
    font-weight: 600;
    padding: 2px 7px;
}

#BrowserPendingBadge {
    background-color: rgba(249, 226, 175, 0.15);
    color: #f9e2af;
    border: 1px solid rgba(249, 226, 175, 0.35);
    border-radius: 4px;
    font-size: 10.5px;
    font-weight: 600;
    padding: 2px 7px;
}

#BrowserInactiveBadge {
    background-color: rgba(147, 153, 178, 0.12);
    color: #9399b2;
    border: 1px solid rgba(147, 153, 178, 0.25);
    border-radius: 4px;
    font-size: 10.5px;
    font-weight: 500;
    padding: 2px 7px;
}

#BrowserUnsupportedBadge {
    background-color: rgba(108, 112, 134, 0.15);
    color: #9399b2;
    border: 1px solid rgba(108, 112, 134, 0.3);
    border-radius: 4px;
    font-size: 10.5px;
    font-weight: 500;
    padding: 2px 7px;
}

#BrowserInstallBtn {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 5px;
    font-size: 11.5px;
    font-weight: 600;
    padding: 4px 12px;
}

#BrowserInstallBtn:hover {
    background-color: #45475a;
    color: #ffffff;
    border-color: #585b70;
}

#BrowserConnectedBtn {
    background-color: rgba(166, 227, 161, 0.1);
    color: #a6e3a1;
    border: 1px solid rgba(166, 227, 161, 0.25);
    border-radius: 5px;
    font-size: 11.5px;
    font-weight: 600;
    padding: 4px 12px;
}
