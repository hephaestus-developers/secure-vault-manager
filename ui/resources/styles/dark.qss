/* ==============================================================================
 * Secure Vault Manager - Dark Theme (Catppuccin Mocha)
 * ============================================================================== */

/* Cửa sổ gốc & font hệ thống */
QMainWindow, QDialog {
    background-color: #1e1e2e;
    color: #cdd6f4;
}

/* Toàn bộ nhãn văn bản mặc định trong suốt */
QLabel {
    background: transparent;
    color: #cdd6f4;
}

/* Khung cửa sổ chính */
#CentralWidget {
    background-color: #1e1e2e;
    border: 1px solid #313244;
}

/* ==============================================================================
 * Thanh Tiêu Đề Tích Hợp (UnifiedHeaderBar)
 * ============================================================================== */
#UnifiedHeaderBar {
    background-color: #181825;
    border-bottom: 1px solid #313244;
}

#HeaderLogo {
    background: transparent;
}

/* Tiêu đề tài liệu / cửa sổ căn giữa */
#HeaderTitleLabel {
    color: #cdd6f4;
    font-size: 13px;
    font-weight: 500;
    background: transparent;
}

/* Thanh Menu nhúng trực tiếp trên HeaderBar */
#EmbeddedMenuBar {
    background: transparent;
    color: #cdd6f4;
}

#EmbeddedMenuBar::item {
    background: transparent;
    padding: 4px 8px;
    border-radius: 4px;
    color: #cdd6f4;
}

#EmbeddedMenuBar::item:selected,
#EmbeddedMenuBar::item:pressed {
    background-color: #313244;
    color: #ffffff;
}

/* Menu xổ xuống (QMenu) cho Dark Theme */
QMenu {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 4px 2px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 24px 6px 30px;
    border-radius: 4px;
    margin: 1px 2px;
}

QMenu::item:selected {
    background-color: #313244;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #585b70;
}

QMenu::separator {
    height: 1px;
    background-color: #313244;
    margin: 4px 6px;
}

/* Dấu tích checkbox/radio tùy biến cho QMenu */
QMenu::indicator {
    width: 14px;
    height: 14px;
    left: 8px;
}

QMenu::indicator:checked {
    image: url(:/icons/menu_check_dark.svg);
}

QMenu::indicator:unchecked {
    image: none;
}

/* ==============================================================================
 * Các Nút Điều Khiển Cửa Sổ (Window Controls)
 * ============================================================================== */
#WinMinBtn, #WinMaxBtn {
    background: transparent;
    border: none;
    border-radius: 0px;
}

#WinMinBtn:hover, #WinMaxBtn:hover {
    background-color: #313244;
}

#WinMinBtn:pressed, #WinMaxBtn:pressed {
    background-color: #45475a;
}

/* Nút Close: Màu đỏ chuẩn với icon dấu X trắng nổi bật khi hover/pressed */
#WinCloseBtn {
    background: transparent;
    border: none;
    border-radius: 0px;
}

#WinCloseBtn:hover {
    background-color: #e81123;
    qproperty-icon: url(:/icons/win_close_white.svg);
}

#WinCloseBtn:pressed {
    background-color: #c40e1d;
    qproperty-icon: url(:/icons/win_close_white.svg);
}

/* ==============================================================================
 * Vùng Chứa Nội Dung (ContentArea) & Khung Thẻ (Cards)
 * ============================================================================== */
#ContentArea {
    background-color: #1e1e2e;
}

#CardWidget {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 24px;
}

#CardWidget QLabel {
    background: transparent;
}

#CardTitleLabel {
    color: #ffffff;
    font-size: 18px;
    font-weight: bold;
    background: transparent;
}

#CardDescLabel {
    color: #a6adc8;
    font-size: 13px;
    background: transparent;
}

/* ==============================================================================
 * Các Nút Bấm Thao Tác (Buttons)
 * ============================================================================== */
QPushButton {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 5px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #45475a;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #585b70;
}

QPushButton#PrimaryButton {
    background-color: #89b4fa;
    color: #11111b;
    border: 1px solid #89b4fa;
    font-weight: bold;
}

QPushButton#PrimaryButton:hover {
    background-color: #b4befe;
    border-color: #b4befe;
}

QPushButton#PrimaryButton:pressed {
    background-color: #74c7ec;
    border-color: #74c7ec;
}

QPushButton#DangerButton {
    background-color: #24273a;
    color: #f38ba8;
    border: 1px solid #45475a;
}

QPushButton#DangerButton:hover {
    background-color: #313244;
    border-color: #f38ba8;
}

QPushButton#DangerButton:pressed {
    background-color: #45475a;
}

/* ==============================================================================
 * Ô Nhập Liệu (Input Fields)
 * ============================================================================== */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #313244;
    border-radius: 5px;
    padding: 6px 10px;
    font-size: 13px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #89b4fa;
    background-color: #1e1e2e;
}

/* ==============================================================================
 * Thanh Cuộn Tối Giản (QScrollBar)
 * ============================================================================== */
QScrollBar:vertical {
    background-color: #1e1e2e;
    width: 8px;
    margin: 0;
    border-radius: 4px;
}

QScrollBar:handle:vertical {
    background-color: #313244;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar:handle:vertical:hover {
    background-color: #45475a;
}

QScrollBar:add-line:vertical, QScrollBar:sub-line:vertical,
QScrollBar:add-page:vertical, QScrollBar:sub-page:vertical {
    background: none;
    border: none;
}

QScrollBar:horizontal {
    background-color: #1e1e2e;
    height: 8px;
    margin: 0;
    border-radius: 4px;
}

QScrollBar:handle:horizontal {
    background-color: #313244;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar:handle:horizontal:hover {
    background-color: #45475a;
}

QScrollBar:add-line:horizontal, QScrollBar:sub-line:horizontal,
QScrollBar:add-page:horizontal, QScrollBar:sub-page:horizontal {
    background: none;
    border: none;
}

/* ==============================================================================
 * Thanh Trạng Thái (StatusBar)
 * ============================================================================== */
#StatusBar, QStatusBar {
    background-color: #181825;
    border-top: 1px solid #313244;
    color: #a6adc8;
    font-size: 11px;
    min-height: 24px;
}

QStatusBar::item {
    border: none;
}

#StatusBar QLabel {
    color: #6c7086;
    font-size: 11px;
    padding: 2px 4px;
    background: transparent;
}

/* ==============================================================================
 * Cấu Trúc 3 Cột (MainThreeColumnSplitter)
 * ============================================================================== */
#MainThreeColumnSplitter {
    background-color: #1e1e2e;
}

#MainThreeColumnSplitter::handle {
    background-color: #313244;
    width: 1px;
}

#MainThreeColumnSplitter::handle:hover {
    background-color: #89b4fa;
}

/* Header Action Buttons */
#HeaderSidebarToggleBtn, #HeaderCommandPaletteBtn {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px;
}

#HeaderSidebarToggleBtn:hover, #HeaderCommandPaletteBtn:hover {
    background-color: #313244;
}

/* 1. Cột 1: SidebarView */
#SidebarView,
#SidebarExpandedContainer,
#SidebarCollapsedContainer {
    background-color: #181825;
    background: #181825;
    border-right: 1px solid #313244;
}

#SidebarToggleBtn {
    background-color: #232634;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 0;
}

#SidebarToggleBtn:hover {
    background-color: #313244;
    border-color: #89b4fa;
}

#SidebarCompactVaultBtn {
    background-color: #232634;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 4px;
}

#SidebarCompactVaultBtn:hover {
    background-color: #313244;
    border-color: #89b4fa;
}

#SidebarCompactList {
    background: transparent;
    border: none;
    outline: none;
}

#SidebarCompactList::item {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

#SidebarCompactLockBtn {
    background-color: #232634;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 6px;
    color: #f38ba8;
}

#SidebarCompactLockBtn:hover {
    background-color: #313244;
    border-color: #f38ba8;
}

#SidebarHeaderWidget {
    background: transparent;
    border-bottom: 1px solid #313244;
}

#VaultProfileBtn {
    background-color: #232634;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 0;
    min-height: 32px;
}

#VaultProfileBtn:hover {
    background-color: #2a2e3f;
    border-color: #89b4fa;
}

#VaultProfileBtn::menu-indicator {
    image: none;
    width: 0;
}

#VaultTitleLabel {
    color: #cdd6f4;
    font-weight: 600;
    font-size: 13px;
    background: transparent;
}

#VaultChevronLabel {
    background: transparent;
    margin-right: 4px;
}

#LockBtnText {
    color: #f38ba8;
    font-weight: 600;
    font-size: 13px;
    background: transparent;
}

#VaultSwitchMenu {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 8px;
    padding: 4px;
    color: #cdd6f4;
}

#SidebarNavList {
    background: transparent;
    border: none;
    outline: none;
    padding: 4px 0;
}

#SidebarFooterWidget {
    background: transparent;
    border-top: 1px solid #313244;
}

#SidebarLockBtn {
    background-color: transparent;
    border: 1px solid rgba(243, 139, 168, 0.25);
    border-radius: 6px;
    padding: 0;
    min-height: 32px;
    color: #f38ba8;
    font-weight: 600;
    text-align: left;
}

#SidebarLockBtn:hover {
    background-color: rgba(243, 139, 168, 0.12);
    border-color: #f38ba8;
}

/* 2. Cột 2: ItemListView */
#ItemListView {
    background-color: #1e1e2e;
    background: #1e1e2e;
    border-right: 1px solid #313244;
}

#ItemListSearchEdit {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 0 10px;
    color: #cdd6f4;
    font-size: 13px;
    min-height: 28px;
    max-height: 28px;
}

#ItemListSearchEdit:focus {
    border-color: #89b4fa;
    background-color: #1e1e2e;
}

#ItemListCountLabel {
    color: #9399b2;
    font-size: 11px;
    font-weight: 600;
}

#ItemListSortCombo {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 2px 20px 2px 8px;
    color: #a6adc8;
    font-size: 11px;
}

#ItemListSortCombo:hover {
    border-color: #89b4fa;
    color: #cdd6f4;
}

QComboBox {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 2px 20px 2px 8px;
    color: #cdd6f4;
    font-size: 11px;
}

QComboBox:hover {
    border-color: #89b4fa;
}

QComboBox:focus {
    border-color: #89b4fa;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    border-left: none;
}

QComboBox::down-arrow {
    image: url(:/icons/chevron_down_dark.svg);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #181825;
    color: #cdd6f4;
    selection-background-color: #313244;
    selection-color: #ffffff;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 3px 8px;
    border-radius: 4px;
    color: #cdd6f4;
}

QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:hover {
    background-color: #313244;
    color: #ffffff;
}

#ItemListNewBtn {
    background-color: #232634;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 0;
    min-height: 28px;
    max-height: 28px;
    min-width: 28px;
    max-width: 28px;
}

#ItemListNewBtn:hover {
    background-color: #313244;
    border-color: #89b4fa;
}

#ItemListNewBtn:pressed {
    background-color: #45475a;
    border-color: #89b4fa;
}

#ItemCardListView {
    background: transparent;
    border: none;
    outline: none;
}

/* 3. Cột 3: DetailInspectorView */
#DetailInspectorView,
#DetailScrollArea,
#DetailScrollViewport,
#DetailContentContainer {
    background-color: #1e1e2e;
    background: #1e1e2e;
    border: none;
}

#EmptyStateTitle {
    color: #cdd6f4;
    font-size: 18px;
    font-weight: bold;
}

#EmptyStateDesc {
    color: #6c7086;
    font-size: 13px;
    line-height: 1.6;
}

#DetailHeaderCard {
    background-color: #181825;
    background: #181825;
    border: 1px solid #313244;
    border-radius: 8px;
}

#DetailHeaderIcon {
    background-color: #232634;
    border-radius: 8px;
}

#DetailHeaderTitle {
    color: #cdd6f4;
}

#DetailHeaderTitleInput {
    background-color: #232634;
    border: 1px solid #89b4fa;
    border-radius: 6px;
    padding: 4px 8px;
    color: #ffffff;
    font-size: 16px;
    font-weight: bold;
}

#DetailCategoryBadge {
    background-color: #313244;
    color: #89b4fa;
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

#DetailCategoryCombo {
    background-color: #232634;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 2px 6px;
    color: #89b4fa;
    font-size: 11px;
    font-weight: 600;
}

#DetailCategoryCombo:hover, #DetailCategoryCombo:focus {
    border-color: #89b4fa;
}

#DetailCategoryCombo::drop-down {
    border: none;
    width: 14px;
}

#DetailCategoryCombo::down-arrow {
    image: url(:/icons/chevron_down_dark.svg);
    width: 10px;
    height: 10px;
}

#DetailUpdatedLabel {
    color: #6c7086;
    font-size: 11px;
}

#DetailHeaderFavBtn, #DetailHeaderEditBtn {
    background-color: #232634;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 6px 12px;
    color: #cdd6f4;
    font-weight: 500;
}

#DetailHeaderFavBtn:hover, #DetailHeaderEditBtn:hover {
    background-color: #313244;
    border-color: #89b4fa;
}

#DetailHeaderCancelBtn {
    background-color: #232634;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 500;
}

#DetailHeaderCancelBtn:hover {
    background-color: #313244;
    border-color: #89b4fa;
    color: #ffffff;
}

#DetailHeaderSaveBtn {
    background-color: #89b4fa;
    color: #11111b;
    border: 1px solid #89b4fa;
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: bold;
}

#DetailHeaderSaveBtn:hover {
    background-color: #b4befe;
    border-color: #b4befe;
}

#TotpFieldWidget {
    background: transparent;
    border: none;
}

#TotpSectionHeader {
    color: #a6adc8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

#TotpTimerLabel {
    color: #a6e3a1;
    font-weight: bold;
    font-size: 12px;
}

#TotpCodeDisplay {
    color: #cdd6f4;
    letter-spacing: 2px;
}

#TotpCopyBtn {
    background-color: #232634;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 5px 12px;
    color: #cdd6f4;
    font-weight: 500;
}

#TotpCopyBtn:hover {
    background-color: #313244;
    border-color: #89b4fa;
}

#TotpProgressBar {
    background-color: #313244;
    border-radius: 2px;
}

#TotpProgressBar::chunk {
    background-color: #a6e3a1;
    border-radius: 2px;
}

#DetailSectionCard {
    background-color: #181825;
    background: #181825;
    border: 1px solid #313244;
    border-radius: 10px;
}

#DetailSectionHeader {
    color: #89b4fa;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 0.8px;
    padding-bottom: 2px;
}

#FieldRowDivider {
    background-color: #2a2b3d;
    min-height: 1px;
    max-height: 1px;
    border: none;
    margin: 2px 6px;
}

#FieldRowWidget, #CustomFieldRowWidget, #TotpFieldWidget {
    background: transparent;
    border: none;
}

#FieldRowLabel {
    color: #a6adc8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

#FieldRowValue {
    color: #cdd6f4;
    font-size: 13px;
    font-weight: 500;
}

#FieldRowInput {
    background-color: #232634;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 6px 10px;
    color: #ffffff;
    font-size: 13px;
}

#FieldRowInput:focus {
    border-color: #89b4fa;
}

#FieldRowActionBtn {
    background: transparent;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 4px;
}

#FieldRowActionBtn:hover {
    background-color: #313244;
    border-color: #89b4fa;
}

#CustomFieldKindCombo {
    background-color: #232634;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 2px 8px;
    color: #cdd6f4;
    font-size: 12px;
}

#CustomFieldKindCombo:focus {
    border-color: #89b4fa;
}

#CustomFieldDeleteBtn {
    background: transparent;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 4px;
}

#CustomFieldDeleteBtn:hover {
    background-color: #452835;
    border-color: #f38ba8;
}

#CustomFieldAddBtn, #AddTotpBtn {
    background-color: #1e1e2e;
    border: 1px dashed #45475a;
    border-radius: 6px;
    color: #89b4fa;
    font-weight: 600;
    font-size: 12px;
}

#CustomFieldAddBtn:hover, #AddTotpBtn:hover {
    background-color: #26293b;
    border-color: #89b4fa;
    color: #b4befe;
}

/* 4. Command Palette Dialog */
#CommandPaletteCard {
    background-color: #181825;
    border: 1px solid #45475a;
    border-radius: 12px;
}

#PaletteSearchInput {
    background-color: #232634;
    border: 1px solid #45475a;
    border-radius: 8px;
    padding: 10px 14px;
    color: #ffffff;
    font-size: 15px;
}

#PaletteSearchInput:focus {
    border-color: #89b4fa;
}

#PaletteResultList {
    background: transparent;
    border: none;
    outline: none;
}
