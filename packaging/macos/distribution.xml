<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Secure Vault Manager</title>
    <organization>io.github.hephaestus.svm</organization>
    <options customize="never" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>

    <choices-outline>
        <line choice="default">
            <line choice="io.github.hephaestus.svm.pkg"/>
        </line>
    </choices-outline>

    <choice id="default"/>
    <choice id="io.github.hephaestus.svm.pkg" visible="false">
        <pkg-ref id="io.github.hephaestus.svm.pkg"/>
    </choice>

    <pkg-ref id="io.github.hephaestus.svm.pkg" version="0.1.0" onConclusion="none">SecureVaultManager-component.pkg</pkg-ref>
</installer-gui-script>
