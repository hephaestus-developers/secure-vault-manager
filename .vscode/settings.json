{
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/debug/compile_commands.json",
  "C_Cpp.intelliSenseEngine": "default",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build/debug",
    "--background-index",
    "--clang-tidy",
    "--completion-style=detailed",
    "--header-insertion=iwyu"
  ],
  "sonarlint.pathToCompileCommands": "${workspaceFolder}/build/debug/compile_commands.json",
  "cmake.configureOnOpen": true,
  "cmake.defaultConfigurePreset": "debug",
  "cmake.defaultBuildPreset": "debug",
  "cmake.sourceDirectory": "${workspaceFolder}",
  "rust-analyzer.linkedProjects": [
    "${workspaceFolder}/core/Cargo.toml"
  ],
  "files.associations": {
    "*.qss": "css"
  }
}
